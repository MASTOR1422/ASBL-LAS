                        <option value="OUI">Actif ASBL (Oui)</option>
                        <option value="NON">Inactif ASBL (Non)</option>
                    </select>

                    <select id="filter-litige" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-las-500">
                        <option value="ALL">Tous statut Cotisation</option>
                        <option value="NON">En Règle (Sans litige)</option>
                        <option value="OUI">En Litige Cotisation</option>
                    </select>

                    <select id="filter-reunion" class="px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-las-500">
                        <option value="ALL">Toutes présences réunion</option>
                        <option value="OUI">Présent (Oui)</option>
                        <option value="NON">Absent (Non)</option>
